<?xml version="1.0" encoding="utf-8"?>
<!-- the player two rows high: a larger logo, three lines, the buttons below -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:maxHeight="112dp"
                android:maxWidth="112dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:id="@+id/w_texts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/w_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/widget_preview_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_preview_artist"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_ripple"
                android:contentDescription="@string/act_prev"
                android:scaleType="center"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/w_play"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_ripple"
                android:contentDescription="@string/act_play"
                android:scaleType="center"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_ripple"
                android:contentDescription="@string/act_next"
                android:scaleType="center"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
